:verificar_python
:: Testar se o Python funciona de fato
python --version >nul 2>&1
if %errorlevel% equ 0 goto rodar_programa

echo Python nao foi encontrado. Iniciando o download automatico...
echo.
echo Baixando o instalador oficial do Python (Aguarde)...

:: Tenta baixar com curl
curl -L -o "%temp%\python-installer.exe" https://www.python.org/ftp/python/3.11.9/python-3.11.9-amd64.exe >nul 2>&1
if exist "%temp%\python-installer.exe" goto instalar_python

:: Se falhar, tenta com PowerShell
echo Curl nao funcionou. Tentando baixar via PowerShell...
powershell -Command "$ProgressPreference = 'SilentlyContinue'; [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; Invoke-WebRequest -Uri 'https://www.python.org/ftp/python/3.11.9/python-3.11.9-amd64.exe' -OutFile '%temp%\python-installer.exe'"

if exist "%temp%\python-installer.exe" goto instalar_python

echo.
echo Erro: Nao foi possivel baixar o Python. Verifique sua conexao com a internet.
pause
exit

:instalar_python
echo.
echo Instalando o Python de forma silenciosa para o usuario...
echo Isto pode levar cerca de 1 minuto. Por favor, aguarde...
echo.

:: Executa o instalador
"%temp%\python-installer.exe" /quiet InstallAllUsers=0 PrependPath=1 Include_test=0

:: Apaga o instalador temporario
del "%temp%\python-installer.exe" >nul 2>&1

echo ======================================================================
echo Python foi instalado com sucesso!
echo.
echo IMPORTANTE: Voce PRECISA fechar esta janela preta e clicar duas vezes
echo no "iniciar_analisador.bat" novamente para iniciar o programa.
echo ======================================================================
echo.
pause
exit

:rodar_programa
python "%~dp0analisador.py"
if %errorlevel% neq 0 (
    echo.
    echo Ocorreu um erro ao executar o programa.
    pause
)
